PORT=8080
DATABASE_URL=postgres://acolhe:acolhe@localhost:5432/acolhe?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
JWT_SECRET=dev-secret-troca-em-producao

# Exportação LGPD: bucket privado S3/S3-compatible e SMTP com STARTTLS.
S3_ENDPOINT=https://s3.example.com
S3_REGION=sa-east-1
S3_BUCKET=acolhe-lgpd-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

SMTP_ADDRESS=smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=privacidade@example.com

# Convites de pacientes por e-mail (mesmo SMTP acima). Com Brevo, use
# SMTP_ADDRESS=smtp-relay.sendinblue.com:587 (o certificado TLS é emitido para
# esse nome, não para smtp-relay.brevo.com). Sem SMTP_ADDRESS o convite
# fica só com o link copiável. FRONTEND_URL é a origem pública do acolhe-web,
# usada para montar o link do convite.
FRONTEND_URL=http://localhost:3000
