# Copie para `.env` NA VM (nunca commitar) e preencha com valores reais:
#   scp este arquivo NÃO — crie manualmente na VM e faça `chmod 600 .env`.
#
# staging usa a tag :develop, production usa a tag :latest.
IMAGE=ghcr.io/acolhedevteam/acolhe-api:develop

POSTGRES_DB=acolhe
POSTGRES_USER=acolhe
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_APP_PASSWORD=troque-por-outra-senha-forte

# O Atlas usa o dono do schema; API e worker usam acolhe_app, sem BYPASSRLS.
DATABASE_URL=postgres://acolhe:troque-por-uma-senha-forte@postgres:5432/acolhe?sslmode=disable
APP_DATABASE_URL=postgres://acolhe_app:troque-por-outra-senha-forte@postgres:5432/acolhe?sslmode=disable

JWT_SECRET=troque-por-um-segredo-forte

# Bucket obrigatoriamente privado. O worker gera links AWS SigV4 com 24h.
S3_ENDPOINT=https://s3.example.com
S3_REGION=sa-east-1
S3_BUCKET=acolhe-lgpd-exports
S3_ACCESS_KEY_ID=preencha
S3_SECRET_ACCESS_KEY=preencha
# S3_SESSION_TOKEN=

SMTP_ADDRESS=smtp.example.com:587
SMTP_USERNAME=preencha
SMTP_PASSWORD=preencha
SMTP_FROM=privacidade@example.com

# Domínio para o HTTPS do Caddy. No deploy automático é INJETADO pelo workflow
# a partir do IP da VM (ex.: 163.176.228.171.nip.io) — não precisa preencher aqui.
# Só defina se for rodar o compose manualmente na VM.
# CADDY_DOMAIN=163.176.228.171.nip.io
